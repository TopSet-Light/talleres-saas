{
  "name": "backend",
  "private": true,
  "scripts": {
    "generate": "prisma generate",
    "build": "pnpm generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "pnpm build && node --test test/*.test.cjs",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed:demo": "node prisma/seed-demo.cjs --demo",
    "test:data": "pnpm build && node scripts/test-data.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "hash-wasm": "4.13.0",
    "nodemailer": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "8.0.2",
    "prisma": "6.19.3",
    "typescript": "~5.9.3"
  }
}
