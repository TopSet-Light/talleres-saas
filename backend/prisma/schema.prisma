generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  RECEPTION
  MECHANIC
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum DocumentKind {
  WORK_ORDER
  ESTIMATE
}

// `name` es el nombre comercial; los demás datos comerciales están en WorkshopSettings.
model Workshop {
  id          String              @id @default(uuid()) @db.Uuid
  name        String              @db.VarChar(160)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships Membership[]
  customers   Customer[]
  vehicles    Vehicle[]
  invitations Invitation[]
  settings    WorkshopSettings?
  numbering   DocumentNumbering[]

  @@map("taller")
}

// Identidad de la persona. Credencial y sesiones viven en tablas propias.
// Solo existe después de probar el control del buzón (registro completado o invitación aceptada).
model User {
  id                  String          @id @default(uuid()) @db.Uuid
  email               String          @unique @db.VarChar(254)
  name                String          @db.VarChar(160)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  membership          Membership?
  credential          Credential?
  sessions            Session[]
  acceptedInvitations Invitation[]    @relation("InvitationAcceptedBy")
  passwordResets      PasswordReset[]
  googleIdentity      GoogleIdentity?

  @@map("usuario")
}

model Membership {
  id              String           @id @default(uuid()) @db.Uuid
  workshopId      String           @map("taller_id") @db.Uuid
  // MVP: una sola pertenencia por usuario, incluso si está inactiva.
  userId          String           @unique @map("usuario_id") @db.Uuid
  role            Role
  status          MembershipStatus @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  workshop        Workshop         @relation(fields: [workshopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sentInvitations Invitation[]

  // Permite relaciones compuestas que exigen que el autor pertenezca al mismo taller.
  @@unique([workshopId, userId])
  @@index([workshopId, status])
  @@map("pertenencia")
}

model Customer {
  id               String             @id @default(uuid()) @db.Uuid
  workshopId       String             @map("taller_id") @db.Uuid
  type             CustomerType       @default(INDIVIDUAL)
  name             String?            @db.VarChar(160)
  phone            String             @db.VarChar(40)
  taxId            String?            @map("dni_cuit") @db.VarChar(20)
  email            String?            @db.VarChar(254)
  address          String?            @db.VarChar(300)
  notes            String?
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  workshop         Workshop           @relation(fields: [workshopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  vehicles         Vehicle[]
  ownershipHistory VehicleOwnership[]

  @@unique([workshopId, id])
  @@index([workshopId, phone])
  @@index([workshopId, name])
  @@index([workshopId, taxId])
  @@map("cliente")
}

model Vehicle {
  id               String             @id @default(uuid()) @db.Uuid
  workshopId       String             @map("taller_id") @db.Uuid
  customerId       String             @map("cliente_id") @db.Uuid
  plate            String?            @map("patente") @db.VarChar(20)
  brand            String?            @db.VarChar(80)
  model            String?            @db.VarChar(100)
  year             Int?
  vin              String?            @db.VarChar(30)
  mileage          Int?
  notes            String?
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  workshop         Workshop           @relation(fields: [workshopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer         Customer           @relation(fields: [workshopId, customerId], references: [workshopId, id], onDelete: Restrict, onUpdate: Restrict)
  ownershipHistory VehicleOwnership[]

  // El índice parcial de patente activa y los triggers están en SQL versionado.
  @@unique([workshopId, id])
  @@index([workshopId, customerId])
  @@index([workshopId, vin])
  @@map("vehiculo")
}

model VehicleOwnership {
  id         String    @id @default(uuid()) @db.Uuid
  workshopId String    @map("taller_id") @db.Uuid
  vehicleId  String    @map("vehiculo_id") @db.Uuid
  customerId String    @map("cliente_id") @db.Uuid
  startedAt  DateTime  @default(now()) @map("desde") @db.Timestamptz(3)
  endedAt    DateTime? @map("hasta") @db.Timestamptz(3)
  vehicle    Vehicle   @relation(fields: [workshopId, vehicleId], references: [workshopId, id], onDelete: Restrict, onUpdate: Restrict)
  customer   Customer  @relation(fields: [workshopId, customerId], references: [workshopId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([workshopId, vehicleId, startedAt])
  @@index([workshopId, customerId])
  @@map("titularidad_vehiculo")
}

// Punto 08 · Acceso. Los tokens se guardan solo como hash SHA-256 en hexadecimal.

model Credential {
  userId          String    @id @map("usuario_id") @db.Uuid
  // Argon2id; el formato se valida también en SQL.
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verificado_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("credencial")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  userId        String    @map("usuario_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("ultimo_uso_at") @db.Timestamptz(3)
  idleExpiresAt DateTime  @map("expira_inactividad_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expira_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revocada_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@map("sesion")
}

// AUTH-01. El formulario de registro no crea usuario, taller ni contraseña: solo esta
// solicitud. Quien abre el enlace enviado al buzón elige la contraseña y completa el alta.
// Varias solicitudes del mismo email conviven; la primera en completarse anula las demás.
model PendingRegistration {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @db.VarChar(254)
  workshopName String    @map("nombre_taller") @db.VarChar(160)
  ownerName    String    @map("nombre_dueno") @db.VarChar(160)
  // Datos opcionales del formulario (TS-21); al completar pasan a la configuración del taller.
  contactPhone String?   @map("telefono") @db.VarChar(40)
  locality     String?   @map("localidad") @db.VarChar(120)
  address      String?   @map("domicilio") @db.VarChar(300)
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expira_at") @db.Timestamptz(3)
  usedAt       DateTime? @map("usada_at") @db.Timestamptz(3)

  // Límite de envíos por destinatario.
  @@index([email, createdAt])
  @@map("registro_pendiente")
}

// AUTH-05. Enlace de un solo uso para elegir una contraseña nueva; se guarda solo su hash.
model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expira_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("usada_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Límite de envíos por destinatario.
  @@index([userId, createdAt])
  @@map("recuperacion_contrasena")
}

// Ingreso con Google: vincula la cuenta de Google (sub) con el usuario la primera vez
// que entra con un email verificado. Después se reconoce por sub, no por email.
model GoogleIdentity {
  userId    String   @id @map("usuario_id") @db.Uuid
  subject   String   @unique @map("sub") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("identidad_google")
}

// Inicio de un ingreso con Google: state (hash), nonce y verificador PKCE, de un solo uso.
model GoogleLoginAttempt {
  id           String    @id @default(uuid()) @db.Uuid
  stateHash    String    @unique @map("state_hash") @db.Char(64)
  nonce        String    @db.VarChar(64)
  codeVerifier String    @map("code_verifier") @db.VarChar(128)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expira_at") @db.Timestamptz(3)
  usedAt       DateTime? @map("usada_at") @db.Timestamptz(3)

  @@map("inicio_google")
}

// AUTH-07 / CFG. Configuración comercial del taller, una fila por taller.
model WorkshopSettings {
  workshopId        String    @id @map("taller_id") @db.Uuid
  taxId             String?   @map("cuit") @db.VarChar(11)
  address           String?   @map("domicilio") @db.VarChar(300)
  locality          String?   @map("localidad") @db.VarChar(120)
  contactPhone      String?   @map("telefono") @db.VarChar(40)
  contactEmail      String?   @map("email_contacto") @db.VarChar(254)
  // Texto para el pie de presupuestos y comprobantes internos.
  documentFooter    String?   @map("pie_documentos") @db.VarChar(1000)
  quoteValidityDays Int       @default(15) @map("vigencia_presupuesto_dias")
  defaultTerms      String?   @map("condiciones_predeterminadas") @db.VarChar(2000)
  // Logo: el archivo vive en almacenamiento privado; acá solo su referencia.
  logoKey           String?   @map("logo_archivo") @db.VarChar(200)
  logoContentType   String?   @map("logo_tipo") @db.VarChar(20)
  logoSize          Int?      @map("logo_bytes")
  logoUpdatedAt     DateTime? @map("logo_actualizado_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  workshop          Workshop  @relation(fields: [workshopId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("configuracion_taller")
}

// Correlativos por taller. El número se asigna con un UPDATE atómico (proximo = proximo + 1).
model DocumentNumbering {
  workshopId String       @map("taller_id") @db.Uuid
  kind       DocumentKind @map("tipo")
  prefix     String       @map("prefijo") @db.VarChar(10)
  next       Int          @default(1) @map("proximo")
  workshop   Workshop     @relation(fields: [workshopId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([workshopId, kind])
  @@map("numeracion_taller")
}

model Invitation {
  id           String     @id @default(uuid()) @db.Uuid
  workshopId   String     @map("taller_id") @db.Uuid
  email        String     @db.VarChar(254)
  role         Role
  tokenHash    String     @unique @map("token_hash") @db.Char(64)
  invitedById  String     @map("invitado_por_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime   @map("expira_at") @db.Timestamptz(3)
  usedAt       DateTime?  @map("usada_at") @db.Timestamptz(3)
  revokedAt    DateTime?  @map("revocada_at") @db.Timestamptz(3)
  acceptedById String?    @map("aceptada_por_id") @db.Uuid
  workshop     Workshop   @relation(fields: [workshopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // Quien invita debe pertenecer al mismo taller.
  invitedBy    Membership @relation(fields: [workshopId, invitedById], references: [workshopId, userId], onDelete: Restrict, onUpdate: Restrict)
  acceptedBy   User?      @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // La invitación pendiente única por email y taller es un índice parcial en SQL.
  @@index([workshopId, email])
  @@map("invitacion")
}
