# Ejemplos solo para desarrollo local. Completar POSTGRES_PASSWORD antes de arrancar.
# Usar letras, números, guiones y guiones bajos (se interpola en una URL).
POSTGRES_USER=talleres
POSTGRES_PASSWORD=cambiar_password_local
POSTGRES_DB=talleres
FRONTEND_PORT=5173
# Interfaz web de Mailpit, el buzón local que recibe los emails de verificación e invitación.
MAILPIT_PORT=8025

# Opcional: ingreso con Google. Crear un cliente OAuth «Aplicación web» en Google Cloud Console
# con la URI de redirección http://localhost:5173/api/auth/google/callback. El secreto no va a Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Producción y staging (no se usan en local: Compose envía los emails a Mailpit).
# La API las recibe por el entorno del servidor, nunca desde este archivo ni desde Git:
# APP_URL=https://taller.example                 # URL pública HTTPS para los enlaces de los emails
# SMTP_HOST=smtp.proveedor.example
# SMTP_PORT=587                                  # 587 con STARTTLS obligatorio o 465 con TLS
# SMTP_USER=                                     # credenciales del proveedor SMTP (secretas)
# SMTP_PASSWORD=
# MAIL_FROM=Gestión de talleres <no-responder@dominio-verificado.example>
# TRUST_PROXY_HOPS=1                             # proxies delante de la API que reemplazan X-Forwarded-For
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=       # cliente OAuth de producción, con la URI {APP_URL}/api/auth/google/callback
# FILES_DIR=/app/backend/data/files              # archivos privados (logos): volumen persistente con backup
