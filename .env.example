# Ejemplos solo para desarrollo local. Completar POSTGRES_PASSWORD antes de arrancar.
# Usar letras, números, guiones y guiones bajos (se interpola en una URL).
POSTGRES_USER=talleres
POSTGRES_PASSWORD=cambiar_password_local
POSTGRES_DB=talleres
FRONTEND_PORT=5173
# Interfaz web de Mailpit, el buzón local que recibe los emails de verificación e invitación.
MAILPIT_PORT=8025

# Correo: smtp usa Mailpit en local. Activar resend solo para enviar correos reales.
MAIL_TRANSPORT=smtp
# Secreto exclusivo de la API. Completar únicamente si MAIL_TRANSPORT=resend.
RESEND_API_KEY=
# Con Resend es obligatorio un remitente del dominio verificado (no @gmail.com).
# MAIL_FROM=TopSet <no-responder@notificaciones.tudominio.com>
# APP_URL=http://localhost:5173                  # en producción: URL pública HTTPS

# Opcional: ingreso y registro con Google. Crear un cliente OAuth «Aplicación web» en Google Cloud Console
# con la URI de redirección http://localhost:5173/api/auth/google/callback. El secreto no va a Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Producción y staging: configurar en el entorno privado del backend, nunca en Git.
# NODE_ENV=production                            # valida HTTPS, cookie segura y proveedor real
# MAIL_TRANSPORT=resend
# RESEND_API_KEY=                                # clave con permiso de envío para el dominio
# APP_URL=https://taller.example
# MAIL_FROM=TopSet <no-responder@notificaciones.tudominio.com>
# Alternativa SMTP: MAIL_TRANSPORT=smtp. Con la API de Resend no hacen falta SMTP_*.
# SMTP_HOST=smtp.proveedor.example
# SMTP_PORT=587                                  # 587 con STARTTLS obligatorio o 465 con TLS
# SMTP_USER=                                     # credenciales del proveedor SMTP (secretas)
# SMTP_PASSWORD=
# TRUST_PROXY_HOPS=1                             # proxies delante de la API que reemplazan X-Forwarded-For
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=       # cliente OAuth de producción, con la URI {APP_URL}/api/auth/google/callback
# FILES_DIR=/app/backend/data/files              # archivos privados (logos): volumen persistente con backup
